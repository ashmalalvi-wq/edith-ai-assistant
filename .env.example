# Copy this file to .env and adjust values as needed.
# .env is gitignored — never commit real API keys.

# --- General ---
APP_NAME=E.D.I.T.H
APP_FULL_NAME=Even Dead, I'm The Hero
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Persona ---
# System prompt injected ahead of every conversation, across all providers.
# Leave unset to use the built-in EDITH persona defined in backend/config/settings.py.
# SYSTEM_PROMPT=

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of origins allowed to call the API (frontend dev server, etc.)
# "null" is required for the packaged Electron desktop app (Phase 8) — it loads the
# built frontend via file://, which sends `Origin: null` on fetch() calls.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,null

# --- AI provider selection ---
# One of: ollama, openai, anthropic
DEFAULT_AI_PROVIDER=ollama

# --- Ollama (local models, primary provider) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b
OLLAMA_REQUEST_TIMEOUT=120

# --- OpenAI (placeholder, future phase) ---
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# --- Anthropic Claude (placeholder, future phase) ---
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5

# --- Structured memory (PostgreSQL) ---
# These POSTGRES_* values configure the Docker container itself; DATABASE_URL
# is what the backend uses to connect and must match them.
POSTGRES_USER=edith
POSTGRES_PASSWORD=edith
POSTGRES_DB=edith
DATABASE_URL=postgresql+asyncpg://edith:edith@localhost:5432/edith

# --- Semantic memory (Qdrant) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=edith_memory
# Must match the embedding model's output dimension (nomic-embed-text = 768).
QDRANT_VECTOR_SIZE=768

# --- Embeddings ---
# Uses the local Ollama instance — run: ollama pull nomic-embed-text
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# --- Memory retrieval tuning ---
MEMORY_SEARCH_TOP_K=5
MEMORY_MIN_SIMILARITY=0.5

# --- Tools (Phase 3) ---
# True when this backend process runs natively on the host (able to touch the
# filesystem, terminal, VS Code, local MCP servers). Set false for the
# Dockerized backend service, which can't see the host.
HOST_MODE=true

# Comma-separated absolute paths the filesystem/terminal/VS Code tools may
# touch. Defaults to the EDITH project root if left unset.
# APPROVED_DIRECTORIES=C:\Users\you\E.D.I.T.H

TERMINAL_SHELL=powershell
TERMINAL_TIMEOUT_SECONDS=30

# Must be on PATH (VS Code's "Shell Command: Install 'code' command in PATH").
VSCODE_COMMAND=code

# --- Productivity capabilities (Phase 5) ---
# Fernet key (32 url-safe base64 bytes) used to encrypt OAuth tokens at rest.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Without this set, Gmail/Calendar report "not configured".
ENCRYPTION_KEY=

# Google OAuth (Gmail + Calendar share one app registration/consent screen).
# Requires registering a real Google Cloud OAuth app — see README for setup.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/google/oauth/callback

# Weather (Open-Meteo — no API key required, just your coordinates).
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_LOCATION_NAME=your location

# Notification quiet hours (HH:MM, 24h, local time)
QUIET_HOURS_START=22:00
QUIET_HOURS_END=07:00

# --- Expert Reasoning Agent ---
# Requires the `claude` CLI (Claude Code) installed and authenticated on PATH.
DEFAULT_EXPERT_REASONING_PROVIDER=claude_code
CLAUDE_CODE_COMMAND=claude
CLAUDE_CODE_DEFAULT_MODEL=
CLAUDE_CODE_TIMEOUT_SECONDS=300

# --- Engineering capabilities (Phase 6) ---
# Bambu printer LAN access (local MQTTS). All optional; without them,
# bambu.* tools report "not configured". See printer's network settings
# for the access code.
BAMBU_PRINTER_IP=
BAMBU_ACCESS_CODE=
BAMBU_SERIAL_NUMBER=
BAMBU_MQTT_TIMEOUT_SECONDS=10

# Name of the MCP server (registered via /api/mcp/servers) whose tools
# back the fusion.* capability. No official Fusion 360 MCP server exists;
# this just names which registered server to look for, if any.
FUSION_MCP_SERVER_NAME=fusion

# --- Automation (Phase 7) ---
AUTOMATION_ENABLED=true
AUTOMATION_MAX_RUNS_PER_MINUTE=20
AUTOMATION_MAX_TRIGGER_DEPTH=5
AUTOMATION_DEFAULT_TIMEZONE=UTC
AUTOMATION_ACTION_TIMEOUT_SECONDS=120
# Defaults to the first approved directory if unset.
AUTOMATION_WATCH_DIRECTORY=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
